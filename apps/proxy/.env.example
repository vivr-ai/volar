# apps/proxy environment variables
#
# See /docs/SECRETS.md at the repo root for the full cross-service
# convention (where each value is stored, how to rotate it). This file
# only lists what apps/proxy itself reads.
#
# Real values are never set here or in any .env file committed to the
# repo — only in Railway: each service's Variables tab, set separately
# for the staging and production environments. For local dev, copy this
# file to .env (gitignored) and fill it in.

# --- Server (issue 1.3) ---
# Port/host the proxy listens on. Railway injects PORT automatically in
# staging/production — these defaults are for local dev only.
PORT=8787
HOST=0.0.0.0

# --- Supabase (Epic 5/6 — event writes) ---
# Service role key: bypasses Row-Level Security, required for the
# ingestion path to write LLMCallEvent rows across any project/org.
# NEVER expose this to a browser context or log it. Not yet wired in
# code as of issue 1.9 — placeholder only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Queue (Epic 7 — Upstash Redis/QStash) ---
# Not yet wired in code as of issue 1.9.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Observability (Epic 19.2/19.3) ---
# Not yet wired in code as of issue 1.9.
SENTRY_DSN=
AXIOM_TOKEN=

# --- Narration layer (Epic 18) ---
# Which service ends up owning the Claude call (this one vs the
# dashboard) is an open architectural question for Epic 18 — listed here
# as the most likely home given the proxy already holds other
# server-only credentials. Not yet wired in code as of issue 1.9.
ANTHROPIC_API_KEY=
