{
  "name": "@volar/proxy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "load-test": "tsx scripts/burst-load-test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "@volar/shared": "workspace:*",
    "fastify": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@volar/config": "workspace:*",
    "@types/node": "^20",
    "eslint": "^9",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^2.1.4"
  }
}
